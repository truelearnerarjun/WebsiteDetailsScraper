# Google Custom Search JSON API Configuration
# Get your free API Key from: https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=

# Create a Search Engine & get the Search Engine ID (CX) from: https://programmablesearchengine.google.com/
# Important: In your search engine settings under "Overview", turn ON "Search the entire web".
GOOGLE_CSE_ID=

# Supabase PostgreSQL Database Configuration
# Get your Project URL & API Key from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
# Use your anon public key or service_role secret key
SUPABASE_KEY=your-supabase-key
# Target table name:
# - For local environment testing: leads_local (default locally)
# - For production / Vercel: leads
SUPABASE_TABLE=leads_local
# Optional: Set to true to automatically sync every scraped lead to Supabase
SUPABASE_AUTO_SYNC=false

# --- Security ---
# REQUIRED in production: password needed to use the app/API.
# Without it the API is locked on Vercel (and open locally for dev).
APP_PASSWORD=change-me-to-a-long-random-password
# Optional: extra tables the client may select (comma-separated). leads, leads_local and SUPABASE_TABLE are always allowed.
SUPABASE_ALLOWED_TABLES=
# Optional: other origins allowed to call the API cross-site (comma-separated). Leave empty if the frontend is on the same domain.
ALLOWED_ORIGINS=

